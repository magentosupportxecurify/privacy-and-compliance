<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MiniOrange\PDProtect\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="MiniOrange\PDProtect\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">MiniOrange_PDProtect</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">MiniOrange\PDProtect\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\HTTP\PhpEnvironment\RemoteAddress">
        <arguments>
            <argument name="alternativeHeaders" xsi:type="array">
                <item name="0" xsi:type="string">HTTP_X_FORWARDED_FOR</item>
            </argument>
        </arguments>
    </type>
</config>
