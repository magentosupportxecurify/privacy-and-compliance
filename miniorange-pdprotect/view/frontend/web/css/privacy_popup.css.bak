/* MiniOrange PDProtect - Frontend Privacy Popup */

.mopdp-popup-wrap {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mopdp-popup-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
}

.mopdp-popup-box {
    position: relative;
    z-index: 1;
    background: #fff;
    border-radius: 12px;
    padding: 2.5rem 2rem 2rem;
    max-width: 680px;
    width: 90%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    text-align: center;
    animation: mopdp-popup-in 0.3s ease;
}

@keyframes mopdp-popup-in {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.mopdp-popup-icon {
    color: rgb(235, 82, 2);
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
}

.mopdp-popup-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #222;
    margin: 0 0 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.mopdp-popup-body {
    font-size: 1.5rem;
    color: #555;
    line-height: 1.6;
    margin: 0 0 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    overflow-y: auto;
    text-align: left;
    padding-right: 0.5rem;
    flex: 1;
    min-height: 0;
}

.mopdp-popup-link {
    color: rgb(235, 82, 2);
    text-decoration: underline;
}

.mopdp-popup-link:hover {
    color: rgb(200, 70, 2);
}

.mopdp-popup-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-shrink: 0;
    padding-top: 1rem;
    border-top: 1px solid #eee;
}

.mopdp-popup-btn {
    padding: 0.65rem 1.75rem;
    border-radius: 6px;
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: background 0.2s, transform 0.1s;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.mopdp-popup-btn:active {
    transform: scale(0.97);
}

.mopdp-popup-btn-accept {
    background: rgb(235, 82, 2);
    color: #fff;
    min-width: 110px;
}

.mopdp-popup-btn-accept:hover {
    background: rgb(200, 70, 2);
}

.mopdp-popup-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 3.4rem;
    line-height: 1;
    color: #888;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
}

.mopdp-popup-close:hover {
    color: #333;
    background: #f0f0f0;
}