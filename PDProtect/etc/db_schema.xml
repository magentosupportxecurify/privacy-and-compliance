<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="miniorange_pdprotect_consent_log" resource="default" engine="innodb"
           comment="PDProtect Privacy Consent Log">
        <column xsi:type="int" name="log_id" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID (null for guests)"/>
        <column xsi:type="varchar" name="visitor_ip" nullable="false" length="45" comment="Visitor IP Address"/>
        <column xsi:type="varchar" name="country_code" nullable="true" length="2" comment="ISO Country Code"/>
        <column xsi:type="varchar" name="visitor_email" nullable="true" length="255" comment="Visitor/Customer Email"/>
        <column xsi:type="varchar" name="consent_status" nullable="false" length="10" comment="accepted or declined"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
    </table>
    <table name="miniorange_pdprotect_deletion_request" resource="default" engine="innodb"
           comment="PDProtect Account Deletion Requests">
        <column xsi:type="int" name="request_id" unsigned="true" nullable="false" identity="true" comment="Request ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="customer_email" nullable="false" length="255" comment="Customer Email"/>
        <column xsi:type="varchar" name="customer_name" nullable="false" length="255" comment="Customer Name"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="pending" comment="pending, approved, rejected"/>
        <column xsi:type="timestamp" name="requested_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Requested At"/>
        <column xsi:type="timestamp" name="processed_at" nullable="true" comment="Processed At"/>
        <column xsi:type="text" name="admin_note" nullable="true" comment="Admin Note"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="request_id"/>
        </constraint>
        <index referenceId="MOPDP_DELETION_REQUEST_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
