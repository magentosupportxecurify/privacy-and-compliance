<script type="text/javascript">
(function () {
    var loginUrl    = '<?= $this->escapeJs($loginUrl) ?>';
    var registerUrl = '<?= $this->escapeJs($registerUrl) ?>';
    var lkUrl       = '<?= $this->escapeJs($lkUrl) ?>';
    var extendUrl   = '<?= $this->escapeJs($extendUrl) ?>';
    var removeUrl   = '<?= $this->escapeJs($removeLkUrl) ?>';

    function mopdpAjax(url, data, onSuccess, msgEl) {
        var fd = new FormData();
        if (msgEl) {
            msgEl.style.display = 'none';
            msgEl.textContent = '';
        }
        for (var k in data) fd.append(k, data[k]);
        fetch(url, { method: 'POST', body: fd })
            .then(function (r) { return r.json(); })
            .then(function (json) {
                if (msgEl) {
                    msgEl.style.display = '';
                    msgEl.style.color = json.success ? '#059669' : '#dc2626';
                    msgEl.textContent = json.message || '';
                }
                if (json.success && onSuccess) onSuccess(json);
            })
            .catch(function () {
                if (msgEl) {
                    msgEl.style.display = '';
                    msgEl.style.color = '#dc2626';
                    msgEl.textContent = 'Request failed.';
                }
            });
    }

    window.mopdpLogin = function () {
        mopdpAjax(loginUrl, {
            email:    document.getElementById('mopdp-login-email').value,
            password: document.getElementById('mopdp-login-password').value
        }, function () { setTimeout(function () { location.reload(); }, 1000); },
        document.getElementById('mopdp-login-msg'));
    };

    window.mopdpRegister = function () {
        mopdpAjax(registerUrl, {
            email: document.getElementById('mopdp-reg-email').value
        }, function () { setTimeout(function () { location.reload(); }, 1500); },
        document.getElementById('mopdp-reg-msg'));
    };

    window.mopdpActivateLK = function () {
        mopdpAjax(lkUrl, {
            lk: document.getElementById('mopdp-lk-input').value
        }, function () { setTimeout(function () { location.reload(); }, 1500); },
        document.getElementById('mopdp-lk-msg'));
    };

    window.mopdpExtendTrial = function () {
        mopdpAjax(extendUrl, {}, function () { location.reload(); }, null);
    };

    window.mopdpRemoveLicense = function () {
        if (!confirm('<?= $this->escapeJs(__('Remove license? The module will revert to trial mode.')->render()) ?>')) return;
        mopdpAjax(removeUrl, {}, function () { location.reload(); }, null);
    };
}());
</script>
