<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="MiniOrange_CookieConsent::css/account.css"/>
        <css src="MiniOrange_CookieConsent::css/fontawesome-navbar.css"/>
    </head>
    <body>
        <!--
            Defining our block and phtml file for Support Form.
            Calls our Admin Block for some common functionality.
            -->
        <referenceContainer name="content">
            <!-- This adds the navbar to the phtml file for easy navigation -->
            <block class="Magento\Framework\View\Element\Template"
                   name="miniorange.oauth.navbar"
                   template="MiniOrange_CookieConsent::Navbar.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">MiniOrange\CookieConsent\ViewModel\Adminhtml\Configure</argument>
                </arguments>
            </block>
            <block class="Magento\Backend\Block\Template"
                   name="miniorange.oauth.admin.support"
                   template="MiniOrange_CookieConsent::Support/page.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">MiniOrange\CookieConsent\ViewModel\Adminhtml\Configure</argument>
                </arguments>
            </block>
        </referenceContainer>
        <!--
            Defining our block and phtml file for adding common
            javascript file to all of our pages
            -->
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   template="MiniOrange_CookieConsent::js.phtml"
                   name="before_body_js">
                <arguments>
                    <argument name="view_model" xsi:type="object">MiniOrange\CookieConsent\ViewModel\Adminhtml\Configure</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
