<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="admin-1column">
    <head>
        <css src="MiniOrange_CookieConsent::css/admin.css"/>
        <css src="MiniOrange_CookieConsent::css/support-widget.css"/>
        <css src="MiniOrange_CookieConsent::css/privacy-upgrade-skin.css"/>
        <css src="MiniOrange_CookieConsent::css/privacy-upgrade-icons.css"/>
        <script src="MiniOrange_CookieConsent::js/admin.js"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="miniorange.privacy.support"
                   template="MiniOrange_CookieConsent::support.phtml"/>
            <block class="MiniOrange\CookieConsent\Block\Adminhtml\Config"
                   name="mo.privacy.config"
                   template="MiniOrange_CookieConsent::Navbar.phtml">
                <block class="MiniOrange\CookieConsent\Block\Adminhtml\Config"
                       name="mo_privacy_tab_banner_settings"
                       template="MiniOrange_CookieConsent::tab/general.phtml"/>
                <block class="MiniOrange\CookieConsent\Block\Adminhtml\Config"
                       name="mo_privacy_tab_script_manager"
                       template="MiniOrange_CookieConsent::tab/script_manager.phtml"/>
                <block class="MiniOrange\CookieConsent\Block\Adminhtml\Config"
                       name="mo_privacy_tab_upgrade"
                       template="MiniOrange_CookieConsent::tab/upgrade.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
