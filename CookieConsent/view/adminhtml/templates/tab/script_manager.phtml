<?php
/**
 * @var \MiniOrange\CookieConsent\Block\Adminhtml\Config $block
 */
$saveUrl = $block->getSaveUrl();
$scanUrl = $block->getScanRunUrl();
$bannerOn = $block->isCookieBannerEnabled();
$blockerCfgOn = $block->isEnabled('script_manager/enabled');
$discoveredRows = $block->getDiscoveredScriptRows();
$catOptions = [
    'necessary' => __('Necessary'),
    'functional' => __('Functional'),
    'analytics' => __('Analytics'),
    'marketing' => __('Marketing (Advertising)'),
];
?>
<div class="mo-tab-content">
    <div class="mo-main-column">
        <form method="post"
              action="<?= $block->escapeUrl($saveUrl) ?>"
              id="mo-privacy-form-script-manager"
              class="mo-form-script-manager">
            <?= /* @noEscape */ $block->getFormKeyHtml() ?>
            <input type="hidden" name="active_tab" value="script_manager"/>

            <div class="mo-card">
                <div class="mo-card__header">
                    <h2 class="mo-card__title"><?= $block->escapeHtml(__('Script Blocker')) ?></h2>
                    <p class="mo-card__subtitle"><?= $block->escapeHtml(__('Control which third-party scripts are blocked until the visitor gives consent.')) ?></p>
                </div>
                <div class="mo-card__body">
                    <div class="mo-field mo-field--toggle">
                        <label class="mo-label"><?= $block->escapeHtml(__('Enable Script Blocker')) ?></label>
                        <div class="mo-field__control">
                            <input type="hidden" name="script_manager[enabled]" value="0"/>
                            <label class="mo-toggle <?= !$bannerOn ? 'mo-toggle--disabled' : '' ?>">
                                <?php if ($bannerOn) : ?>
                                    <input type="checkbox"
                                           name="script_manager[enabled]"
                                           value="1"
                                           <?= $blockerCfgOn ? 'checked="checked"' : '' ?>/>
                                <?php else : ?>
                                    <input type="checkbox"
                                           disabled="disabled"
                                            <?= $blockerCfgOn ? 'checked="checked"' : '' ?>/>
                                <?php endif; ?>
                                <span class="mo-toggle__slider"></span>
                            </label>
                        </div>
                    </div>
                    <?php if (!$bannerOn) : ?>
                        <div class="mo-note mo-note--spaced">
                            <?= $block->escapeHtml(
                                __('The Cookie consent banner is disabled. Turn it on under the General tab before enabling Script Blocker.')
                            ) ?>
                        </div>
                    <?php endif; ?>

                </div>
            </div>

            <div class="mo-card">
                <div class="mo-card__header">
                    <h2 class="mo-card__title"><?= $block->escapeHtml(__('Detected Scripts')) ?></h2>
                    <p class="mo-card__subtitle"><?= $block->escapeHtml(__('These third-party scripts were detected on your storefront homepage. Assign each one to the correct consent category. New scripts found by re-scan default to Necessary until you change them.')) ?></p>

                </div>
                <div class="mo-card__body">
                    <?php if ($discoveredRows === []) : ?>
                        <div class="mo-note"><?= $block->escapeHtml(__('No scripts detected yet. Use Re-scan below to fetch scripts from your homepage.')) ?></div>
                    <?php else : ?>
                        <div class="table-container">
                            <table class="mo-table mo-table--admin-grid">
                                <thead>
                                    <tr>
                                        <th><?= $block->escapeHtml(__('Script URL')) ?></th>
                                        <th><?= $block->escapeHtml(__('Category')) ?></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <?php foreach ($discoveredRows as $i => $row) : ?>
                                        <tr>
                                            <td class="mo-table__url">
                                                <input type="hidden"
                                                       name="script_manager[detected][<?= (int) $i ?>][url]"
                                                       value="<?= $block->escapeHtmlAttr($row['url']) ?>"/>
                                                <code title="<?= $block->escapeHtmlAttr($row['url']) ?>"><?= $block->escapeHtml($row['url']) ?></code>
                                            </td>
                                            <td class="mo-table__category">
                                                <select name="script_manager[detected][<?= (int) $i ?>][category]"
                                                        class="mo-select">
                                                    <?php foreach ($catOptions as $val => $label) : ?>
                                                        <option value="<?= $block->escapeHtmlAttr($val) ?>"
                                                            <?= $row['category'] === $val ? ' selected="selected"' : '' ?>>
                                                            <?= $block->escapeHtml($label) ?>
                                                        </option>
                                                    <?php endforeach; ?>
                                                </select>
                                            </td>
                                        </tr>
                                    <?php endforeach; ?>
                                </tbody>
                            </table>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
        </form>

        <div class="mo-actions mo-actions--row">
            <button type="submit"
                    form="mo-privacy-form-script-manager"
                    class="mo-btn mo-btn--primary">
                <?= $block->escapeHtml(__('Save')) ?>
            </button>
            <form method="post"
                  action="<?= $block->escapeUrl($scanUrl) ?>"
                  id="mo-privacy-form-rescan"
                  class="mo-rescan-form">
                <?= /* @noEscape */ $block->getFormKeyHtml() ?>
                <button type="submit" class="mo-btn mo-btn--primary">
                    <?= $block->escapeHtml(__('Re-scan Scripts')) ?>
                </button>
            </form>
        </div>
    </div>
</div>
